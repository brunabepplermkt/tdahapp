# Nada disso é necessário para rodar o app (dados ficam no navegador).
# Preencha só quando for conectar o Supabase. Use APENAS a anon/publishable key:
# a service role NUNCA entra no cliente (o app a detecta e recusa).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Futuro: provider de IA para interpretar capturas (somente no servidor, nunca NEXT_PUBLIC_).
# ANTHROPIC_API_KEY=
